{
  "name": "tensormesh-rpa",
  "version": "1.0.0",
  "description": "GPU-Accelerated Vision-Agent Automation for Nebius x NVIDIA Global AI Hackathon",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "test": "npm run typecheck && tsx test/verify_tensormesh.ts && tsx test/eval.test.ts && tsx test/server_integration.ts",
    "docker:build": "docker build -t tensormesh-rpa:latest .",
    "docker:run": "docker run -d -p 3004:3004 --name tensormesh-rpa tensormesh-rpa:latest",
    "tunnel": "powershell -ExecutionPolicy Bypass -File deploy/free/tunnel.ps1",
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/server.ts",
    "test:unit": "tsx test/verify_tensormesh.ts",
    "test:integration": "tsx test/server_integration.ts",
    "test:eval": "tsx test/eval.test.ts",
    "coverage": "c8 sh -c \"tsx test/verify_tensormesh.ts && tsx test/eval.ts && tsx test/server_integration.ts\""
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "c8": "^10.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "nvidia",
    "nebius",
    "gpu",
    "vllm",
    "tensorrt",
    "vision-agent",
    "rpa",
    "grounding"
  ],
  "author": "Antigravity Builder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
